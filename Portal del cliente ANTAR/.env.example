# WEBSITE — public canonical identity, read at build time.
# Use the final HTTPS domain in Vercel Production; localhost is for development.
SITE_URL=http://localhost:3000
# Indexing requires BOTH this opt-in and Vercel's VERCEL_ENV=production.
# Keep false until real content, canonical URLs and launch checks are approved.
SITE_INDEXABLE=false

# SUPABASE — optional for the public reference pages.
# Required when adding authentication, data or Storage features.
# NEXT_PUBLIC values are embedded in the browser bundle: redeploy after changes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Runtime readiness dependency. Enable for a product that needs the backend.
SUPABASE_REQUIRED=false
# SERVER-ONLY. Leave empty unless an authorized admin operation requires it.
SUPABASE_SECRET_KEY=

# VERCEL_ENV is provided by Vercel. Do not override it in the dashboard.
# Never copy Production credentials into Preview or Development.

# KYC — delivery by email (server-only secrets; never NEXT_PUBLIC).
# Gmail: enable 2-step verification and create an "App password" for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional display sender, e.g. Alta de clientes <cuenta@gmail.com>. Defaults to SMTP_USER.
MAIL_FROM=
# Institutional recipients, comma separated (max 20).
KYC_MAIL_TO=
# Cloudflare Turnstile (anti-bot). Required in Production.
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upload limits. Vercel functions accept at most 4.5 MB per request: keep 4 there.
# Self-hosted Node.js can raise the total up to ~15 (Gmail rejects messages over 25 MB).
KYC_MAX_TOTAL_MB=4
KYC_MAX_FILE_MB=4
# Best-effort submissions per client IP and hour (per instance).
KYC_RATE_LIMIT=5
# true on Vercel or behind a trusted reverse proxy that sets X-Forwarded-For.
KYC_TRUST_PROXY=false
# Local tests only: build the PDFs without sending email; optionally save them to a folder.
KYC_DRY_RUN=false
KYC_OUTPUT_DIR=
